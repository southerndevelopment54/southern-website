# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in all values before starting the services.
# NEVER commit .env to version control.
#
# To generate strong secrets automatically, run:
#   ./init-secrets.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO (Application-level credentials for Spring Boot)
# -----------------------------------------------------------------------------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# -----------------------------------------------------------------------------
# MinIO (Container root credentials — required at container startup)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# CORS (cross-origin resource sharing)
# -----------------------------------------------------------------------------
# In production behind nginx (same origin), leave empty.
# For local dev with frontend on localhost:3000, use: http://localhost:3000
# For multiple origins, comma-separate: https://yourdomain.com,https://www.yourdomain.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Email Notifications (optional — if omitted, notifications are logged only)
# -----------------------------------------------------------------------------
# SMTP server for sending internal notifications (e.g., Gmail, Outlook, SendGrid)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Set to true/false depending on your SMTP provider
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Sender address for notification emails
NOTIFICATION_FROM=noreply@southern-services.example.com

# -----------------------------------------------------------------------------
# Admin User (created on first deployment)
# -----------------------------------------------------------------------------
# Generate the hash first, then paste it here:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# Or use: htpasswd -bnBC 10 "" your-password | tr -d ':\n' | sed 's/$2y/$2a/'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Also used as fallback notification recipient if no admin users have emails
ADMIN_EMAIL=admin@localhost

# -----------------------------------------------------------------------------
# JWT (must be at least 64 characters for HS512 algorithm)
# -----------------------------------------------------------------------------
JWT_SECRET=
